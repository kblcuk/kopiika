amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

// Top-level steps materialise the check, fix and pre-commit hooks from one list.
steps {
  // Builtin commands are structured argv in hk v2, and argv commands reject a
  // shell-string prefix — pass the prefix as argv too.
  ["oxlint"] = (Builtins.ox_lint) {
    prefix = List("bun", "run")
  }

  ["oxfmt"] = (Builtins.oxfmt) {
    prefix = List("bun", "run")
    // Mise has it's own formatter
    exclude = List("**/mise.toml", "**/mise.local.toml")
  }

  ["tsgo"] {
    // Type checking doesn't need file locking
    stomp = true
    prefix = "bun run"
    workspace_indicator = "tsconfig.json"
    glob = List("**/*.ts", "**/*.tsx")
    check = "tsgo --noEmit -p {{workspace_indicator}}"
  }

  ["pkl"] = Builtins.pkl

  // The builtin pairs check_diff with check_after_diff, which is what our own
  // fix override used to emulate: shellcheck --format=diff only fixes some
  // findings, so hk re-runs the gating check after applying the patch instead
  // of treating a clean apply as success.
  ["shellcheck"] = Builtins.shellcheck

  ["mise"] = Builtins.mise
}

hooks {
  ["pre-commit"] {
    // Implicit hooks default to stash = "none"; keep git stashing so a partial
    // `git add -p` commit is linted against the staged content only.
    fix = true
    stash = "git"
  }
}
